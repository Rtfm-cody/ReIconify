<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_gravity="center_horizontal|top"
    android:gravity="center_horizontal|top">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:gravity="center_horizontal|top"
        android:orientation="vertical">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="-10dp"
            android:format12Hour="hh"
            android:format24Hour="HH"
            android:gravity="center"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:tag="text1|nolineheight"
            android:textColor="@android:color/white"
            android:textSize="130sp"
            android:fontFamily="@font/eunomia"
            android:textStyle="bold" />

        <TextClock
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="-10dp"
            android:includeFontPadding="false"
            android:format12Hour="mm"
            android:format24Hour="mm"
            android:gravity="center_horizontal"
            android:singleLine="true"
            android:tag="text1"
            android:textColor="@android:color/@android:color/system_accent1_200"
            android:textSize="130sp"
            android:fontFamily="@font/eunomia"
            android:textStyle="bold" />

        <TextClock
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="-12dp"
            android:format12Hour="EEEE"
            android:format24Hour="EEEE"
            android:gravity="center_horizontal"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:singleLine="true"
            android:textAlignment="center"
            android:fontFamily="@font/kagero"
            android:textAllCaps="true"
            android:tag="accent2"
            android:textColor="@android:color/system_accent2_200"
            android:textSize="12sp" />

        <TextClock
            android:includeFontPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="MMMM dd"
            android:format24Hour="MMMM dd"
            android:singleLine="true"
            android:tag="text1"
            android:textAlignment="center"
            android:textAllCaps="true"
            android:fontFamily="@font/kagero"
            android:textColor="@android:color/white"
            android:textSize="8sp" />
    </LinearLayout>
</LinearLayout>